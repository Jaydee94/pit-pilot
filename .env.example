# Copy to `.env` (gitignored) to override local-stack defaults.
# `make up` already works with zero config; these enable login + push.

# Session cookie signing key — any non-empty string for local dev.
SESSION_SIGNING_KEY=dev-only-change-me

# OAuth — REQUIRED for real "Sign in with Google".
# Create an OAuth 2.0 "Web application" client in the Google Cloud Console
# (APIs & Services -> Credentials), and under "Authorized JavaScript origins"
# add the app origin(s): http://localhost:8080 for the local compose stack,
# plus your real domain in production. Paste the generated client ID here.
# The same value is used by the browser (GIS) and the backend verifier.
# The api also contacts Google OIDC discovery at startup, so it needs internet.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Web Push (VAPID) — optional. Without a private key the notification
# worker simply stays off; the rest of the app works normally.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:dev@example.com

# Dev-only dummy login (type a name -> logged in). The compose stack sets this
# to true; leave it false/unset in production. Never enable in a real deployment.
ALLOW_DEV_LOGIN=false
